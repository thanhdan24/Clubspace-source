{
    "name": "clubspace",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "install:ci": "pnpm install --frozen-lockfile",
        "dev": "vite --config standalone/vite.config.ts",
        "build": "vite build --config standalone/vite.config.ts",
        "start": "node --env-file=.env --import tsx server/node.ts",
        "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:migrate": "prisma migrate dev",
        "db:studio": "prisma studio",
        "db:seed": "node --env-file=.env --import tsx scripts/seed-supabase.ts",
        "dev:frontend": "vite --config standalone/vite.config.ts",
        "test": "node --import tsx --test tests/*.test.ts",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write \"components/club/**/*.tsx\" \"server/**/*.ts\" \"tests/**/*.ts\" \"app/**/*.tsx\" \"app/**/*.ts\" app/globals.css"
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "@hookform/resolvers": "^5.7.1",
        "@prisma/client": "^6.4.1",
        "@shadcn/react": "^0.3.0",
        "bcryptjs": "^3.0.3",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.4.0",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.4.2",
        "lucide-react": "^1.31.0",
        "next": "16.3.4",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.6.7",
        "react": "19.2.6",
        "react-day-picker": "^10.0.1",
        "react-dom": "19.2.6",
        "react-hook-form": "^7.85.0",
        "react-resizable-panels": "^4.12.2",
        "recharts": "^3.8.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "3.6.0",
        "tsx": "^4.23.13",
        "vaul": "^1.1.2",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "4.2.1",
        "@types/node": "22.19.19",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.2",
        "eslint": "9.39.4",
        "eslint-config-next": "16.3.4",
        "prettier": "^3.9.6",
        "prisma": "6.4.1",
        "tailwindcss": "4.2.1",
        "tw-animate-css": "^1.4.0",
        "typescript": "5.9.3",
        "vite": "8.0.13"
    },
    "type": "module",
    "packageManager": "pnpm@11.25.0"
}
