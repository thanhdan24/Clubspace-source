# =======================================================
# SUPABASE & POSTGRESQL (Dùng với Prisma)
# =======================================================
# Connection pooling URL cho runtime (Supabase Transaction Pooler - Port 6543):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection URL cho Prisma migration / schema push (Session / Direct - Port 5432):
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Project Credentials (tùy chọn khi dùng Supabase Storage/Auth client):
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# =======================================================
# CẤU HÌNH SERVER & ỨNG DỤNG
# =======================================================
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3001
UPLOAD_DIR=private-uploads

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=1234567890
